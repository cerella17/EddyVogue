<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd" id="WebApp_ID" version="3.1">
  <display-name>Eddy Vogue</display-name>
  <welcome-file-list>
    <welcome-file>ProductView.jsp</welcome-file>
  </welcome-file-list>
  <resource-ref>
    <description>JNDI reference to a data source</description>
    <res-ref-name>jdbc/eddyvogue</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>
  
  
  <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>

    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error.jsp</location>
    </error-page>
  
  <servlet>
    <servlet-name>Home</servlet-name>
    <servlet-class>eddy.vogue.control.ProductControl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Home</servlet-name>
    <url-pattern>/home</url-pattern>
  </servlet-mapping>
  
    <servlet>
    <servlet-name>Uomo</servlet-name>
    <servlet-class>eddy.vogue.control.Uomocontrol</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Uomo</servlet-name>
    <url-pattern>/uomo</url-pattern>
  </servlet-mapping>
  
   <servlet>
    <servlet-name>Donna</servlet-name>
    <servlet-class>eddy.vogue.control.Donnacontroller</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Donna</servlet-name>
    <url-pattern>/donna</url-pattern>
  </servlet-mapping>
    
   <servlet>
    <servlet-name>Catalogo</servlet-name>
    <servlet-class>eddy.vogue.control.CatalogoController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Catalogo</servlet-name>
    <url-pattern>/catalogo</url-pattern>
  </servlet-mapping>
  
   <servlet>
    <servlet-name>CartControl</servlet-name>
    <servlet-class>eddy.vogue.control.CartControl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CartControl</servlet-name>
    <url-pattern>/carrello</url-pattern>
  </servlet-mapping>
  
  
  
  
    <servlet>
    <servlet-name>ordiniutente</servlet-name>
    <servlet-class>eddy.vogue.control.OrdiniController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ordiniutente</servlet-name>
    <url-pattern>/ordiniutente</url-pattern>
  </servlet-mapping>
  
      <servlet>
    <servlet-name>ordiniutenti</servlet-name>
    <servlet-class>eddy.vogue.control.OrdiniAdminController</servlet-class>
  </servlet>
