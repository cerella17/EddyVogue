  </servlet-mapping>
  
   <servlet>
    <servlet-name>Checkout</servlet-name>
    <servlet-class>eddy.vogue.control.CheckoutController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Checkout</servlet-name>
    <url-pattern>/Checkout</url-pattern>
  </servlet-mapping>
  
  <servlet>
    <servlet-name>Login</servlet-name>
    <servlet-class>eddy.vogue.control.User</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Login</servlet-name>
    <url-pattern>/user</url-pattern>
