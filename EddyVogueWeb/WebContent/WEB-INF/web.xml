    <servlet-name>ordiniutenti</servlet-name>
    <url-pattern>/admin/ordiniutenti</url-pattern>
  </servlet-mapping>
  
       <servlet>
    <servlet-name>dashboardadmin</servlet-name>
    <servlet-class>eddy.vogue.control.OrdiniAdminControllerDash</servlet-class>
  </servlet>
